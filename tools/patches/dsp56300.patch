+	// The lock-free ring (Lock=false, HDI08's RX/TX) with a producer writing BLOCKS: push_some publishes each
+	// block with one count update. Order and contents must match what the per-entry push_back path delivers;
+	// a stall exits with 2 like the blocking test. Block sizes vary, and the ring is smaller than a block, so a
+	// block is split across waits.
+	bool runBlocks(const char* const _name, const bool _bulk)
+	{
+		constexpr size_t Cap = 64;
+		dsp56k::RingBuffer<uint32_t, Cap, false> rb;
+		constexpr uint64_t Items = 4'000'000;
+		std::atomic<bool> failed{false};
+		std::atomic<uint64_t> consumed{0};
+		const auto tStart = std::chrono::steady_clock::now();
+
+		std::thread producer([&]
+		{
+			std::mt19937 rng(3);
+			std::uniform_int_distribution<size_t> d(1, 100);
+			std::vector<uint32_t> block;
+			for(uint64_t i = 0; i < Items && !failed.load();)
+			{
+				block.resize(std::min<uint64_t>(d(rng), Items - i));
+				for(size_t k = 0; k < block.size(); ++k)
+					block[k] = static_cast<uint32_t>(i + k);
+				for(size_t k = 0; k < block.size();)
+				{
+					rb.waitNotFull();
+					if(_bulk)
+						k += rb.push_some(block.size() - k, [&](const size_t _j) { return block[k + _j]; });
+					else
+						rb.push_back(block[k++]);
+				}
+				i += block.size();
+			}
+		});
+		std::thread consumer([&]
+		{
+			for(uint64_t i = 0; i < Items; ++i)
+			{
+				rb.waitNotEmpty();
+				const uint32_t v = rb.pop_front();
+				if(v != static_cast<uint32_t>(i))
+				{
+					std::cerr << "  " << _name << ": MISMATCH at " << i << " got " << v << std::endl;
+					failed.store(true);
+					return;
+				}
+				consumed.store(i + 1, std::memory_order_relaxed);
+			}
+		});
+		std::thread watchdog([&]
+		{
+			uint64_t last = 0;
+			for(int stalled = 0; consumed.load() < Items && !failed.load();)
+			{
+				std::this_thread::sleep_for(std::chrono::seconds(1));
+				const uint64_t c = consumed.load();
+				stalled = c == last ? stalled + 1 : 0;
+				last = c;
+				if(stalled >= 10)
+				{
+					std::cerr << "  " << _name << ": STALL at " << c << std::endl;
+					std::_Exit(2);
+				}
+			}
+		});
+		producer.join();
+		consumer.join();
+		watchdog.join();
+		if(failed.load())
+			return false;
+		const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - tStart).count();
+		std::cout << "  " << _name << ": " << Items << " items ok in " << ms << " ms" << std::endl;
+		return true;
+	}
 }
 
