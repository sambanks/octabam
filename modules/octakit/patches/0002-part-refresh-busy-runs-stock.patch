--- a/octabam_part_refresh_busy.S
+++ b/octabam_part_refresh_busy.S
@@ -0,0 +1,109 @@
+/*
+ * A track button pressed while a queued pattern change is in flight
+ * (about 250 ms around the change, a chain or a single switch) halted at
+ * gk_stock_part_refresh_writer_report_fatal_part_refresh_fatal_context:
+ * gk_stock_current_context_validate returns GK_ERR_BUSY while
+ * __gk_sequencer_latch_queue_handoff is set, and the Part-refresh writer
+ * took every negative return as the context fatal (measured under the
+ * ColdFire port, 5 Oct 2026, Octakit alone and bottleservice).
+ *
+ * machine_selection.S and midi_bit_toggle.S test BUSY before their fatal
+ * and return it to a caller that handles it.  The Part-refresh writer
+ * wraps a stock call with nobody to return BUSY to, so these routines
+ * stand in for its four validator calls (same-length jsr swaps, her
+ * layout kept) and, on BUSY:
+ *   - before the write, run the stock writer the way her QUIESCED path
+ *     does, with no Kit lease, and return to the stock caller.  d7
+ *     carries UNWRAPPED through the stock body (stock's writer saves and
+ *     uses d2-d6/a2-a5 only), and the dirty-store marker replays stock's
+ *     store for it;
+ *   - after a wrapped write, release the descriptor and return, the
+ *     post-write compares skipped.
+ * Each routine is entered by jsr from inside her frame: 4(%sp) is her
+ * frame's 0(%sp).  What the Kit workspace misses by not seeing an
+ * unwrapped run's dirty marks is not measured.
+ */
+        .include "abi.inc"
+        .set    OB_PART_REFRESH_TOKEN_UNWRAPPED,0x46550000
+        .section .runtime.octabam,"ax"
+        .align  4
+
+        .global gk_octabam_part_refresh_pre_engine
+        .type   gk_octabam_part_refresh_pre_engine,@function
+gk_octabam_part_refresh_pre_engine:
+        jsr     gk_stock_latest_engine_context_validate
+        cmpi.l  #GK_ERR_BUSY,%d0
+        beq.s   .Lob_part_refresh_unwrapped
+        rts
+        .size   gk_octabam_part_refresh_pre_engine,.-gk_octabam_part_refresh_pre_engine
+
+        .global gk_octabam_part_refresh_pre_settled
+        .type   gk_octabam_part_refresh_pre_settled,@function
+gk_octabam_part_refresh_pre_settled:
+        jsr     gk_stock_current_context_validate
+        cmpi.l  #GK_ERR_BUSY,%d0
+        bne.s   .Lob_part_refresh_rts
+.Lob_part_refresh_unwrapped:
+        lea     4(%sp),%sp
+        move.l  #OB_PART_REFRESH_TOKEN_UNWRAPPED,%d7
+        jsr     gk_stock_part_refresh_writer_trampoline
+        movem.l (%sp),%d2-%d7/%a2-%a6
+        lea     68(%sp),%sp
+.Lob_part_refresh_rts:
+        rts
+        .size   gk_octabam_part_refresh_pre_settled,.-gk_octabam_part_refresh_pre_settled
+
+        .global gk_octabam_part_refresh_post_engine
+        .type   gk_octabam_part_refresh_post_engine,@function
+gk_octabam_part_refresh_post_engine:
+        jsr     gk_stock_latest_engine_context_validate
+        cmpi.l  #GK_ERR_BUSY,%d0
+        beq.s   .Lob_part_refresh_post_busy
+        rts
+        .size   gk_octabam_part_refresh_post_engine,.-gk_octabam_part_refresh_post_engine
+
+        .global gk_octabam_part_refresh_post_settled
+        .type   gk_octabam_part_refresh_post_settled,@function
+gk_octabam_part_refresh_post_settled:
+        jsr     gk_stock_current_context_validate
+        cmpi.l  #GK_ERR_BUSY,%d0
+        bne.s   .Lob_part_refresh_rts
+.Lob_part_refresh_post_busy:
+        lea     4(%sp),%sp
+        btst    #0,%d3
+        beq.s   .Lob_part_refresh_post_restore
+        move.l  %d6,%d0
+        jsr     gk_descriptor_release
+        tst.l   %d0
+        beq.s   .Lob_part_refresh_post_restore
+        jmp     gk_part_refresh_stock_call_report_fatal_part_refresh_fatal_release
+.Lob_part_refresh_post_restore:
+        move.l  44(%sp),%d0
+        move.l  48(%sp),%d1
+        movea.l 52(%sp),%a0
+        movea.l 56(%sp),%a1
+        move.w  60(%sp),%d2
+        move.w  %d2,%sr
+        movem.l (%sp),%d2-%d7/%a2-%a6
+        lea     68(%sp),%sp
+        rts
+        .size   gk_octabam_part_refresh_post_settled,.-gk_octabam_part_refresh_post_settled
+
+        /* In place of the marker's `cmpi.l #1,%d0`: the same compare's
+           condition codes come back through rts for her bne, unless d7
+           carries UNWRAPPED, which replays stock's dirty store the way
+           her QUIESCED branch does (d1 back from the marker's push). */
+        .global gk_octabam_part_refresh_marker_check
+        .type   gk_octabam_part_refresh_marker_check,@function
+gk_octabam_part_refresh_marker_check:
+        move.l  %d7,%d1
+        andi.l  #GK_PART_REFRESH_TOKEN_STATE_MASK,%d1
+        cmpi.l  #OB_PART_REFRESH_TOKEN_UNWRAPPED,%d1
+        beq.s   .Lob_part_refresh_marker_unwrapped
+        cmpi.l  #1,%d0
+        rts
+.Lob_part_refresh_marker_unwrapped:
+        lea     4(%sp),%sp
+        move.l  (%sp)+,%d1
+        jmp     gk_part_refresh_stock_dirty_store
+        .size   gk_octabam_part_refresh_marker_check,.-gk_octabam_part_refresh_marker_check
